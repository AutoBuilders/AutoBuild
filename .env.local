MONITORING_STACK_DIR=./monitoring

DB=mysql
DB_URL=jdbc:mysql://mysql-db:3306/pipeline?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=testuser
DB_PASSWORD=testpass

DB_ROOT_PASSWORD=root

# OpenFeature OFREP-compatible feature flag provider (e.g. flagd, Flagsmith).
# Leave empty to disable feature flags (all flags will evaluate to false).
# For Docker: hardwired to http://flagd:8016 in docker-compose.yml.
# flagd OFREP port is 8016; gRPC port is 8013.
FEATURE_PROVIDER_URI=http://localhost:8016