test --test_env=WORKSPACE_DIR
test --test_env=PATH
test --test_env=JAVA_HOME

# Used by //pipeline:generate-openapi genrule which needs PATH/JAVA_HOME to find mvn.
# Applied only when explicitly passed: bazel build --config=openapi //pipeline:generate-openapi
build:openapi --action_env=PATH
build:openapi --action_env=JAVA_HOME
